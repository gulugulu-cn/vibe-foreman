# 项目清单
# Claude 调度中心通过此文件了解所有项目的位置和信息
#
# 使用方法：
#   1. 复制此文件: cp projects.yaml.example projects.yaml
#   2. 配置 scan_dirs，然后运行: bash scripts/scan-projects.sh
#   3. 或手动添加项目

# 扫描目录 — 运行 scan-projects.sh 时自动扫描这些目录下的 git 仓库
# 支持多个目录，用户说"扫描项目"时直接读取，无需传参
scan_dirs:
  - ~/Documents/code

projects:
  - name: my-app
    aliases: [app, 前端]
    path: ~/Documents/code/my-app
    description: "示例前端项目"
    tags: [frontend, react]

  - name: my-api
    aliases: [api, backend, 后端]
    path: ~/Documents/code/my-api
    description: "示例后端项目"
    tags: [backend, go]

  # 添加更多项目...
  # - name: another-project
  #   aliases: [another]
  #   path: ~/Documents/code/another-project
  #   description: "另一个项目"
  #   tags: [tag1, tag2]
